<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is Jetpack Compose, so the window theme only has to pick colours;
         the Material Components theme is not needed and pulls a lot of resources. -->
    <style name="Theme.TgWsProxy" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/neon_cyan</item>
        <item name="android:colorAccent">@color/neon_violet</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
